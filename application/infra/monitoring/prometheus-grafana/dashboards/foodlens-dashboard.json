  "liveNow": false,
  "panels": [
    {
      "title": "FoodLens Microservices HTTP Request Rate (req/sec)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[5m])) by (app)",
          "legendFormat": "{{app}}"
        }
      ]
    },
    {
      "title": "FoodLens Microservices 95th Percentile Latency (ms)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, app)) * 1000",
          "legendFormat": "{{app}} (p95)"
        }
      ]
    },
    {
      "title": "CPU Usage per Microservice",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        {
          "expr": "sum(node_namespace_pod_container:container_cpu_usage_seconds_total:sum_irate{namespace=~\"foodlens.*\"}) by (pod)",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "title": "Memory Usage per Microservice",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=~\"foodlens.*\"}) by (pod)",
          "legendFormat": "{{pod}}"
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 38,
  "style": "dark",
  "tags": ["foodlens", "microservices"],
  "time": { "from": "now-1h", "to": "now" },
  "title": "FoodLens AI - Platform Overview",
